{
  "name": "trustcare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-tidecloak-third-party-check.mjs",
    "dev": "vite",
    "dev:api": "node --watch server/index.js",
    "dev:tidecloak-proxy": "node server/tidecloak-proxy.js",
    "start": "node server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@tidecloak/react": "0.14.33",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^6.3.5"
  }
}
